     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2 3\n"
     ]
    }
   ],
   "source": [
    "n = int(input())\n",
    "inp = input()\n",
    "\n",
    "numbers = inp.split()\n",
    "\n",
    "numbs = [int(x) for x in numbers]\n",
    "low=int(numbers[0])\n",
    "\n",
    "for i in range(n):\n",
    "    x=int(numbers[i])\n",
    "    if x<low:\n",
    "        low=x\n",
    "\n",
    "    pos = numbs.index(low)+1\n",
    "\n",
    "print(low, pos)\n"
   ]
  },
